rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador del panel: permiso "admin" en su token
    // (se asigna con tool/hacer_admin.js).
    function esAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // PERFIL DEL USUARIO
    match /usuarios/{userId} {

      allow read: if (request.auth != null && request.auth.uid == userId)
                  || esAdmin();

      // Solo los datos del perfil: el plan, el rol y el estado los cambia
      // el administrador (o el servidor), nunca el propio estudiante.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly([
                         'correo', 'nombre', 'rol', 'estado',
                         'fechaCreacion', 'carreraPostulada'])
                    && request.resource.data.rol == 'estudiante'
                    && request.resource.data.estado == 'activo';

      // "ultimaActividad" solo con la hora del servidor (la usa el panel).
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['nombre', 'carreraPostulada', 'ultimaActividad'])
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['ultimaActividad'])
                        || request.resource.data.ultimaActividad == request.time);

      // El administrador solo cambia el vencimiento de Premium.
      allow update: if esAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['premiumHasta']);

      allow delete: if false;
    }

    // CONFIGURACIÓN DE LA ACADEMIA (precio, Yape, límites del plan gratis)
    match /config/{documento} {

      allow read: if request.auth != null;

      allow write: if esAdmin();
    }

    // CUPONES Y BECAS: el estudiante consulta uno por su código (no puede
    // listarlos); solo el administrador los crea y cambia.
    match /cupones/{codigo} {

      allow get: if request.auth != null;

      allow list, create, update, delete: if esAdmin();
    }

    // PAGOS DE PREMIUM: el estudiante registra el suyo como pendiente y el
    // administrador lo aprueba o rechaza. Id = metodo__operacion, así nadie
    // reclama la misma operación de Yape dos veces. Nunca se borran.
    // Avisos del equipo (arriba del Inicio). El estudiante lee solo los
    // activos; la app descarta los vencidos y los de otra versión.
    match /avisos/{avisoId} {

      allow read: if (request.auth != null && resource.data.activo == true)
                  || esAdmin();

      allow create, update: if esAdmin()
                    && request.resource.data.keys().hasOnly([
                         'titulo', 'mensaje', 'versionId', 'importante',
                         'activo', 'hasta', 'creadoEn'])
                    && request.resource.data.titulo is string
                    && request.resource.data.titulo.size() >= 1
                    && request.resource.data.titulo.size() <= 80
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() <= 600
                    && request.resource.data.importante is bool
                    && request.resource.data.activo is bool
                    && request.resource.data.hasta is timestamp
                    && (request.resource.data.get('versionId', null) == null
                        || request.resource.data.versionId is string);

      allow delete: if esAdmin();
    }

    // Reportes que el estudiante manda con la bandera ("esta pregunta está
    // mal", "el video no carga"). Solo el suyo, siempre 'nuevo'; el
    // administrador cambia el estado y responde. Nunca se borran.
    match /reportes/{reporteId} {

      allow read: if (request.auth != null
                      && resource.data.usuarioId == request.auth.uid)
                  || esAdmin();

      allow create: if request.auth != null
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'usuarioId', 'nombre', 'correo', 'tipo', 'mensaje',
                         'contexto', 'estado', 'creadoEn'])
                    && request.resource.data.estado == 'nuevo'
                    && request.resource.data.creadoEn == request.time
                    && request.resource.data.tipo in [
                         'preguntaExamen', 'preguntaPractica', 'video',
                         'material', 'app', 'otro']
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() >= 5
                    && request.resource.data.mensaje.size() <= 1000
                    && request.resource.data.contexto is map
                    && request.resource.data.contexto.keys().hasOnly([
                         'titulo', 'examenId', 'preguntaId', 'versionId',
                         'temaId']);

      allow update: if esAdmin();
      allow delete: if false;
    }

    match /pagos/{pagoId} {

      allow read: if (request.auth != null
                      && resource.data.usuarioId == request.auth.uid)
                  || esAdmin();

      allow create: if esAdmin() || (
                      request.auth != null
                      && request.resource.data.usuarioId == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                           'usuarioId', 'nombre', 'correo', 'monto', 'metodo',
                           'operacion', 'cupon', 'estado', 'creadoEn', 'fotoUrl'])
                      && request.resource.data.estado == 'pendiente'
                      && request.resource.data.creadoEn == request.time
                      && request.resource.data.monto is int
                      && request.resource.data.monto >= 0
                      && request.resource.data.monto <= 1000
                      && (
                        (request.resource.data.metodo in ['yape', 'plin']
                          && request.resource.data.operacion.matches('[0-9]{6,20}')
                          && pagoId == request.resource.data.metodo + '__'
                               + request.resource.data.operacion)
                        || (request.resource.data.metodo == 'beca'
                          && request.resource.data.monto == 0
                          && request.resource.data.cupon is string
                          && pagoId == 'beca__' + request.auth.uid + '__'
                               + request.resource.data.cupon)
                      ));

      allow update: if esAdmin();

      allow delete: if false;
    }

    // MATRICULAS
    match /matriculas/{matriculaId} {

      allow read: if (request.auth != null
                      && resource.data.usuarioId == request.auth.uid)
                  || esAdmin();

      // Las crea y cambia el administrador desde el panel. Nunca se borran:
      // se suspenden o finalizan.
      allow create, update: if esAdmin();

      allow delete: if false;
    }

    // REGISTRO DE ACCIONES DEL PANEL: quién hizo qué y cuándo. Solo se
    // agregan entradas; nadie las cambia ni las borra.
    match /registro_admin/{accionId} {

      allow read: if esAdmin();

      allow create: if esAdmin()
                    && request.resource.data.adminUid == request.auth.uid
                    && request.resource.data.fecha == request.time;

      allow update, delete: if false;
    }

    // VERSIONES ACADEMICAS
    match /versiones_academicas/{versionId} {

      allow read: if request.auth != null;

      // El administrador las crea y cambia desde el panel; no se borran
      // (se archivan).
      allow create, update: if esAdmin();

      allow delete: if false;
    }

    // PLANES ACADEMICOS
    match /planes_academicos/{planId} {

      allow read: if request.auth != null;

      allow write: if esAdmin();
    }

    // CURSOS
    match /cursos/{cursoId} {

      allow read: if request.auth != null;

      allow write: if false;
    }

    // TEMAS
    match /temas/{temaId} {

      allow read: if request.auth != null;

      allow write: if false;
    
    }
    
    // CONTENIDOS (qué se enseña en cada tema)
    match /contenidos/{contenidoId} {

      allow read: if request.auth != null;

      allow write: if esAdmin();
    }

    // RECURSOS (videos, PDF y material de apoyo por versión)
    match /recursos/{recursoId} {

      allow read: if request.auth != null;

      allow write: if esAdmin();
    }

    // EVALUACIONES Y PREGUNTAS (sin respuestas correctas)
    match /evaluaciones/{evaluacionId} {

      allow read: if request.auth != null;

      allow write: if esAdmin();
    }

    match /preguntas/{preguntaId} {

      allow read: if request.auth != null;

      allow write: if esAdmin();
    }

    // CLAVES: las lee Cloud Functions (Admin SDK) y el administrador. Nunca el
    // estudiante.
    match /claves_preguntas/{preguntaId} {

      // El administrador las copia al crear una versión nueva.
      allow read, write: if esAdmin();
    }

    // INTENTOS Y RESPUESTAS: los escribe Cloud Functions; el estudiante
    // solo puede leer los suyos.
    match /intentos_evaluacion/{intentoId} {

      allow read: if (request.auth != null
                      && resource.data.usuarioId == request.auth.uid)
                  || esAdmin();

      allow write: if false;
    }

    match /respuestas/{respuestaId} {

      allow read: if request.auth != null
                  && resource.data.usuarioId == request.auth.uid;

      allow write: if false;
    }

    // EVIDENCIAS (entrada del modelo del estudiante): las escribe
    // Cloud Functions; el estudiante solo lee las suyas.
    match /evidencias/{evidenciaId} {

      allow read: if (request.auth != null
                      && resource.data.usuarioId == request.auth.uid)
                  || esAdmin();

      allow write: if false;
    }

    // RESÚMENES POR VERSIÓN (1 lectura en vez de cientos)
    match /curriculos/{versionId} {

      allow read: if request.auth != null;

      allow write: if esAdmin();
    }

    match /publicaciones_version/{versionId} {

      allow read: if request.auth != null;

      allow write: if esAdmin();
    }

    // PUBLICACIONES DE TEMAS
    match /publicaciones_temas/{publicacionId} {

      allow read: if request.auth != null;

      allow write: if esAdmin();
    }

    // PROGRESO DE LA CLASE (video): cada estudiante lee y escribe solo el
    // suyo. Id: {uid}__{version}__{tema}.
    match /progreso_clases/{progresoId} {

      allow read: if (request.auth != null
                      && progresoId.matches(request.auth.uid + '__.*'))
                  || esAdmin();

      allow create, update: if request.auth != null
                            && request.resource.data.usuarioId == request.auth.uid
                            && progresoId == request.auth.uid + '__'
                                 + request.resource.data.versionId + '__'
                                 + request.resource.data.temaId
                            && request.resource.data.tramos is list
                            && request.resource.data.tramos.size() <= 400
                            && request.resource.data.duracion is number
                            && request.resource.data.completada is bool;

      allow delete: if false;
    }

    // MATERIAL DEL TUTOR (texto de la separata o teoría por tema): lo
    // escribe el administrador y lo lee Cloud Functions.
    match /material_tutor/{documento} {

      allow read, write: if esAdmin();
    }

    // USO DEL TUTOR (límite diario): solo Cloud Functions.
    match /uso_tutor/{usoId} {

      allow read, write: if false;
    }

    // EXÁMENES PASADOS: enunciados y opciones visibles; las claves y el
    // índice para armar simulacros solo los lee Cloud Functions.
    match /examenes/{examenId} {

      allow read: if request.auth != null;

      allow write: if esAdmin();
    }

    match /preguntas_examen/{preguntaId} {

      allow read: if request.auth != null;

      allow write: if esAdmin();
    }

    match /claves_examen/{preguntaId} {

      allow read, write: if esAdmin();
    }

    // EXAMEN SEMANAL: lo prepara el administrador por versión y semana. El
    // estudiante nunca lee las preguntas antes: se las da Cloud Functions
    // el fin de semana, y las claves solo al corregir.
    match /examenes_semanales/{examenId} {
      allow read, write: if esAdmin();
    }

    match /preguntas_semanales/{preguntaId} {
      allow read, write: if esAdmin();
    }

    match /claves_semanales/{preguntaId} {
      allow read, write: if esAdmin();
    }

    match /indices/{indiceId} {

      allow read, write: if esAdmin();
    }

    // EXAMEN TIPO ADMISIÓN: lo crea y corrige Cloud Functions; el estudiante
    // solo lee los suyos.
    match /simulacros/{simulacroId} {

      allow read: if (request.auth != null
                      && resource.data.usuarioId == request.auth.uid)
                  || esAdmin();

      allow write: if false;
    }

    // SEMINARIOS (enlaces de YouTube): lectura para estudiantes.
    match /seminarios/{seminarioId} {

      allow read: if request.auth != null;

      allow write: if false;
    }
  }
}
