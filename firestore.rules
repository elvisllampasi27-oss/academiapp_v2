rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // PERFIL DEL USUARIO
    match /usuarios/{userId} {

      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.rol == 'estudiante'
                    && request.resource.data.estado == 'activo';

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.rol == resource.data.rol
                    && request.resource.data.estado == resource.data.estado;

      allow delete: if false;
    }

    // MATRICULAS
    match /matriculas/{matriculaId} {

      allow read: if request.auth != null
                  && resource.data.usuarioId == request.auth.uid;

      allow create, update, delete: if false;
    }

    // VERSIONES ACADEMICAS
    match /versiones_academicas/{versionId} {

      allow read: if request.auth != null;

      allow create, update, delete: if false;
    }

    // PLANES ACADEMICOS
    match /planes_academicos/{planId} {

      allow read: if request.auth != null;

      allow write: if false;
    }

    // CURSOS
    match /cursos/{cursoId} {

      allow read: if request.auth != null;

      allow write: if false;
    }

    // TEMAS
    match /temas/{temaId} {

      allow read: if request.auth != null;

      allow write: if false;
    
    }
    
    // CONTENIDOS (qué se enseña en cada tema)
    match /contenidos/{contenidoId} {

      allow read: if request.auth != null;

      allow write: if false;
    }

    // RECURSOS (videos, PDF y material de apoyo por versión)
    match /recursos/{recursoId} {

      allow read: if request.auth != null;

      allow write: if false;
    }

    // EVALUACIONES Y PREGUNTAS (sin respuestas correctas)
    match /evaluaciones/{evaluacionId} {

      allow read: if request.auth != null;

      allow write: if false;
    }

    match /preguntas/{preguntaId} {

      allow read: if request.auth != null;

      allow write: if false;
    }

    // CLAVES: solo las lee Cloud Functions (Admin SDK). Nunca el cliente.
    match /claves_preguntas/{preguntaId} {

      allow read, write: if false;
    }

    // INTENTOS Y RESPUESTAS: los escribe Cloud Functions; el estudiante
    // solo puede leer los suyos.
    match /intentos_evaluacion/{intentoId} {

      allow read: if request.auth != null
                  && resource.data.usuarioId == request.auth.uid;

      allow write: if false;
    }

    match /respuestas/{respuestaId} {

      allow read: if request.auth != null
                  && resource.data.usuarioId == request.auth.uid;

      allow write: if false;
    }

    // PUBLICACIONES DE TEMAS
    match /publicaciones_temas/{publicacionId} {

      allow read: if request.auth != null;

      allow write: if false;
    }
  }
}
