rules_version = '2';

// Storage (con el plan Blaze; hoy se prueba con el emulador).
// Comprobantes: cada estudiante sube los suyos; los lee él y el
// administrador. Imágenes de hasta 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /comprobantes/{uid}/{archivo} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || request.auth.token.admin == true);

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');

      allow update, delete: if false;
    }

    // Figuras de exámenes y prácticas: las sube el administrador desde el
    // panel; las ve cualquier estudiante con sesión. Imágenes de hasta 5 MB.
    match /examenes/{ruta=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.admin == true
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /semanales/{ruta=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.admin == true
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /temas/{ruta=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.admin == true
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Narraciones de los temas: audio de hasta 20 MB que sube el
    // administrador; lo escucha cualquier estudiante con sesión.
    match /narraciones/{ruta=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.token.admin == true
                            && request.resource.size < 20 * 1024 * 1024
                            && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null
                    && request.auth.token.admin == true;
    }

    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
