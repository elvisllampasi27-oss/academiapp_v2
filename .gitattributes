# Finales de línea LF en el repositorio (evita los avisos LF/CRLF en Windows).
* text=auto eol=lf

# Archivos de Windows que necesitan CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.jar binary
